<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="mat_image_hdr_emission_test" type="material" nodedef="ND_surfacematerial">
    <input name="surfaceshader" type="surfaceshader" nodename="surface_shader1" />
  </surfacematerial>
  <standard_surface name="surface_shader1" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base_color" type="color3" value="0.05, 0.05, 0.05" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="metalness" type="float" value="0.0" />
    <input name="emission" type="float" value="1.0" />
    <input name="emission_color" type="color3" output="out" nodegraph="hdr_texture_graph" />
  </standard_surface>
  <nodegraph name="hdr_texture_graph">
    <image name="hdr_texture" type="color3">
      <input name="file" type="filename" value="../textures/memorial.hdr" />
      <input name="default" type="color3" value="1.0, 0.0, 1.0" />
    </image>
    <output name="out" type="color3" nodename="hdr_texture" />
  </nodegraph>
</materialx>
